{
	"name": "extension",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"dev": "pnpm dev:firefox",
		"dev:chrome": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build && wxt build -b firefox",
		"zip": "wxt zip && wxt zip -b firefox",
		"icons": "for size in 16 32 48 128; do rsvg-convert -w $size -h $size assets/icon.svg -o public/icon/$size.png; done && rsvg-convert -w 440 -h 280 assets/promo-tile.svg -o store/promo-tile-440x280.png",
		"screenshots": "scripts/store-screenshots.sh",
		"postinstall": "wxt prepare",
		"check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@wxt-dev/module-svelte": "^2.0.5",
		"happy-dom": "^21.0.4",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8",
		"web-ext": "^10.8.0",
		"wxt": "^0.21.5"
	}
}
